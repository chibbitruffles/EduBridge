# EduBridge Backend Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

# Server
PORT=3000
NODE_ENV=development

# MySQL Database (existing edubridge database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password_here
DB_NAME=edubridge

# Full database connection URL (Prisma uses this)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:your_mysql_root_password_here@127.0.0.1:3306/edubridge

# JWT Secrets (change these to strong, unique values in production)
JWT_ACCESS_SECRET=your_access_token_secret_change_me
JWT_REFRESH_SECRET=your_refresh_token_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads/materials